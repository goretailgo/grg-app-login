<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="grg_app_login_qr_wizard_form" model="ir.ui.view">
        <field name="name">grg.app.login.qr.wizard.form</field>
        <field name="model">grg.app.login.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="App Login QR">
                <field name="state" invisible="1"/>
                <field name="allowed_company_ids" invisible="1"/>
                <field name="session_id" invisible="1"/>

                <!-- Step 1: configure -->
                <group invisible="state != 'draft'">
                    <group string="App Login">
                        <field name="user_id" options="{'no_create': True}"/>
                        <field name="company_id" options="{'no_create': True}"
                               domain="[('id', 'in', allowed_company_ids)]"/>
                        <field name="company_name"/>
                    </group>
                    <group string="Server">
                        <field name="odoo_url"/>
                        <field name="odoo_db"/>
                        <field name="validity_seconds"/>
                        <field name="duration"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                    The QR holds only a <b>one-time token</b> valid for a few seconds.
                    The API key is created only when the app scans it, and you will see the confirmation here.
                </div>

                <!-- Step 2: live QR + scan acknowledgement -->
                <div invisible="state != 'done'">
                    <field name="session_ref" widget="grg_qr_session" nolabel="1" class="w-100"/>
                </div>

                <footer>
                    <button name="action_generate" type="object" string="Generate QR"
                            class="btn-primary" invisible="state != 'draft'" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" invisible="state != 'draft'" data-hotkey="x"/>
                    <button name="action_regenerate" type="object" string="Regenerate QR"
                            class="btn-secondary" invisible="state != 'done'" data-hotkey="r"/>
                    <button name="action_done" type="object" string="Close"
                            class="btn-primary" invisible="state != 'done'" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_grg_app_login_qr_wizard" model="ir.actions.act_window">
        <field name="name">App Login QR</field>
        <field name="res_model">grg.app.login.qr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_grg_app_login_qr"
              name="App Login QR"
              parent="base.menu_users"
              action="action_grg_app_login_qr_wizard"
              groups="base.group_system"
              sequence="90"/>

    <record id="action_grg_app_login_qr_from_user" model="ir.actions.act_window">
        <field name="name">App Login QR</field>
        <field name="res_model">grg.app.login.qr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="context">{'default_user_id': active_id}</field>
    </record>
</odoo>
