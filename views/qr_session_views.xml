<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="grg_app_login_qr_session_list" model="ir.ui.view">
        <field name="name">grg.app.login.qr.session.list</field>
        <field name="model">grg.app.login.qr.session</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                  decoration-success="state == 'scanned'"
                  decoration-muted="state in ('expired', 'cancelled', 'revoked')"
                  decoration-info="state == 'pending'">
                <field name="id" string="#"/>
                <field name="create_date" string="Generated"/>
                <field name="create_uid" string="Generated By"/>
                <field name="user_id"/>
                <field name="company_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'scanned'"
                       decoration-info="state == 'pending'"
                       decoration-danger="state == 'revoked'"/>
                <field name="scanned_at"/>
                <field name="device_name"/>
                <field name="scanned_ip"/>
                <field name="key_expiration"/>
            </list>
        </field>
    </record>

    <record id="grg_app_login_qr_session_form" model="ir.ui.view">
        <field name="name">grg.app.login.qr.session.form</field>
        <field name="model">grg.app.login.qr.session</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_revoke_key" type="object" string="Revoke API Key"
                            class="btn-danger" invisible="state != 'scanned'"
                            confirm="Revoke this API key? The app using it will be logged out."/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,scanned"/>
                </header>
                <sheet>
                    <group>
                        <group string="Login">
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="company_name"/>
                            <field name="odoo_url"/>
                            <field name="odoo_db"/>
                        </group>
                        <group string="QR">
                            <field name="create_date" string="Generated"/>
                            <field name="create_uid" string="Generated By"/>
                            <field name="validity_seconds"/>
                            <field name="expires_at"/>
                        </group>
                        <group string="Scan Acknowledgement">
                            <field name="scanned_at"/>
                            <field name="device_name"/>
                            <field name="scanned_ip"/>
                        </group>
                        <group string="API Key">
                            <field name="key_name"/>
                            <field name="key_duration"/>
                            <field name="key_expiration"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="grg_app_login_qr_session_search" model="ir.ui.view">
        <field name="name">grg.app.login.qr.session.search</field>
        <field name="model">grg.app.login.qr.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="device_name"/>
                <filter name="scanned" string="Scanned" domain="[('state', '=', 'scanned')]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_grg_app_login_qr_session" model="ir.actions.act_window">
        <field name="name">App Login Sessions</field>
        <field name="res_model">grg.app.login.qr.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_grg_app_login_qr_session"
              name="App Login Sessions"
              parent="base.menu_users"
              action="action_grg_app_login_qr_session"
              groups="base.group_system"
              sequence="91"/>
</odoo>
